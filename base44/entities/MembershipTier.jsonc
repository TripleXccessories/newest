{
  "name": "MembershipTier",
  "type": "object",
  "properties": {
    "tier_key": {
      "type": "string",
      "description": "Unique slug e.g. free, retail, pro, institutional, beta"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name e.g. Pro Trader"
    },
    "tagline": {
      "type": "string",
      "description": "Short marketing tagline"
    },
    "monthly_price_usd": {
      "type": "number",
      "default": 0
    },
    "annual_price_usd": {
      "type": "number",
      "default": 0,
      "description": "Annual price (usually discounted)"
    },
    "annual_discount_pct": {
      "type": "number",
      "default": 0,
      "description": "Percentage discount for annual billing"
    },
    "beta_lifetime_discount_pct": {
      "type": "number",
      "default": 30,
      "description": "Lifetime discount for beta testers who complete High School"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of features included in this tier"
    },
    "signal_access": {
      "type": "string",
      "enum": [
        "none",
        "basic",
        "standard",
        "full",
        "institutional"
      ],
      "default": "basic"
    },
    "bot_rental_slots": {
      "type": "number",
      "default": 0,
      "description": "How many bots can be rented simultaneously"
    },
    "max_open_positions": {
      "type": "number",
      "default": 5
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in pricing pages"
    },
    "color_hex": {
      "type": "string",
      "description": "Brand color for this tier"
    },
    "icon_symbol": {
      "type": "string",
      "description": "Emoji or symbol used as tier icon e.g. \u26a1 \ud83d\udc51 \ud83d\udd31"
    }
  },
  "required": [
    "tier_key",
    "display_name"
  ]
}